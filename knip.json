{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["bin/build", "bin/check", "bin/agent-check", "bin/tailor", "bin/lib/*.ts"],
      "project": ["bin/**"]
    },
    "core": {
      "entry": ["packs/*/*/spec.ts", "packs/**/*.test.ts", "src/*.ts", "packs/pwa/pwa/worker.ts"],
      "project": ["**/*.ts"]
    },
    "react": {
      "entry": ["src/*.{ts,tsx}", "src/*/*/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "html": {
      "entry": ["src/*/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "showcase": {
      "entry": [
        "src/entry.tsx",
        "src/entry-sections.tsx",
        "src/main.tsx",
        "src/pages/*.tsx",
        "src/static-pages.tsx",
        "check.ts",
        "check-pwa.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "cli": {
      "entry": ["src/main.ts", "src/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "checks": {
      "entry": ["src/*.ts", "behaviour/*/*.ts"],
      "project": ["**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  "ignoreDependencies": ["@iconify-json/bi", "@iconify-json/simple-icons", "axe-core"]
}
