#!/usr/bin/env bun
// build — regenerate palettes/*.css (every canonical palette found), the Primer themes
// (react/adapters/primer/themes/*, from the pinned @primer/primitives in react/ — skipped with a note when it is
// not installed), the icon-set entries + showcase sprite (from the @iconify-json packages pinned in icons/ — the
// committed ones are kept with a note when they are not installed), the showcase kit bundle (showcase/kit/, Vite over
// react/demo — kept when react/node_modules is missing), manifest.json (vocabulary + skins + palettes + compatibility matrix — the file agents, the CLI
// and the React adapter read) and showcase/index.html. Idempotent; run after any change to core/components.json,
// a skin or a palette.
//
//   bin/build                 everything
//   bin/build --no-palettes   skip palette + Primer theme regeneration (keep the committed files)
//   bin/build --no-kit        skip the showcase kit bundle (keep the committed showcase/kit/)

import { writeFileSync, mkdirSync, existsSync, readdirSync, statSync } from "node:fs";
import { join } from "node:path";
import { ROOT, SKINS, PALETTES_OUT, SHOWCASE, VERSION, readJson, listSkins, listSourcePalettes, loadPalette, paletteCss, paletteModes } from "./lib/common.js";
import { renderShowcase } from "./lib/showcase.js";
import { primerThemesDir, primerMissingMessage, listPrimerPalettes } from "./lib/primer.js";
import { writePrimerThemes, writePrimerIndex } from "./gen-primer-theme";
import { listIconSets, iconsInstalled, iconsMissingMessage, manifestIconSets, showcaseSprite, sampleIcons } from "./lib/icons.js";

const argv = process.argv.slice(2);
const log = (m) => console.log(m);

// 1. palettes
mkdirSync(PALETTES_OUT, { recursive: true });
const palettes = [];
const sourceIds = listSourcePalettes();
if (!argv.includes("--no-palettes") && sourceIds.length) {
  for (const id of sourceIds) {
    const p = loadPalette(id);
    writeFileSync(join(PALETTES_OUT, `${p.id}.css`), paletteCss(p));
    palettes.push(p);
  }
  log(`palettes: wrote ${palettes.length} → palettes/*.css`);
} else {
  // Offline: keep whatever CSS is committed, read metadata back from the file headers.
  for (const f of readdirSync(PALETTES_OUT).filter((f) => f.endsWith(".css")).sort()) {
    const id = f.slice(0, -4), text = Bun.file(join(PALETTES_OUT, f)).toString();
    palettes.push({ id, name: id, mode: /color-scheme: light;[^]*?\n\}/.test(text) && !/\[data-mode="light"\]/.test(text) ? "light" : "dark", light: /\[data-mode="light"\]/.test(text) ? {} : undefined, license: "see file header", docs: "" });
  }
  log(`palettes: source dir unavailable, kept ${palettes.length} committed files`);
}
const modes = Object.fromEntries(palettes.map((p) => [p.id, paletteModes(p)]));

// 1b. Primer themes (palettes with a `primer` section → react/adapters/primer/themes/dark_<id>.css [+ light_<id>.css] + index.ts)
if (!argv.includes("--no-palettes") && sourceIds.length) {
  const ids = listPrimerPalettes();
  if (!primerThemesDir()) log(`primer themes: skipped — ${primerMissingMessage()}`);
  else if (ids.length) {
    let n = 0;
    for (const id of ids) n += writePrimerThemes(id).length;
    writePrimerIndex(ids);
    log(`primer themes: wrote ${n} (${ids.length} palettes × modes) → react/adapters/primer/themes/*.css + index.ts`);
  }
}

// 2. skins
const skins = listSkins().map((id) => ({ ...readJson(join(SKINS, id, "manifest.json")), path: `skins/${id}/` }));
log(`skins: ${skins.length ? skins.map((s) => s.id).join(" ") : "(none yet)"}`);

// 3. compatibility: skin × palette → ok when the palette offers a mode the skin accepts and is not excluded
const compat = {};
for (const s of skins) {
  compat[s.id] = {};
  for (const p of palettes) {
    const want = s.palette_constraints.mode;
    const okMode = want === "both" ? true : modes[p.id].includes(want);
    const needs = (s.palette_constraints.needs ?? []).every((n) => (n === "light" ? !!p.light : n === "accent_solid" ? !!p.accent_solid : !!p.extra?.[n]));
    const excluded = (s.palette_constraints.exclude ?? []).includes(p.id);
    compat[s.id][p.id] = okMode && needs && !excluded ? modes[p.id].filter((m) => want === "both" || m === want) : [];
  }
}

// 3b. icon sets: manifest entries (showcase/icons.svg is written in step 5, after the showcase HTML it must cover)
let iconSets = [], iconSamples = {};
const committedManifest = existsSync(join(ROOT, "manifest.json")) ? readJson(join(ROOT, "manifest.json")) : null;
if (iconsInstalled()) {
  iconSets = manifestIconSets();
  for (const s of iconSets) iconSamples[s.id] = sampleIcons(s.id);
  log(`icon sets: ${iconSets.map((s) => `${s.id} ${s.count}`).join(", ")} → manifest`);
} else {
  iconSets = committedManifest?.icon_sets ?? [];
  for (const s of iconSets) iconSamples[s.id] = s.samples ?? [];
  log(`icon sets: skipped — ${iconsMissingMessage()}; kept ${iconSets.length} committed entries`);
}

// 4. manifest.json
const vocab = readJson(join(ROOT, "core", "components.json"));
const manifest = {
  $schema: "manifest.schema.json",
  name: "tailor",
  version: VERSION,
  generated: new Date().toISOString(),
  contract: { prefix: vocab.prefix, token_prefix: vocab.token_prefix, tones: vocab.tones, sizes: vocab.sizes, groups: vocab.groups, conventions: "core/conventions.md", skin_contract: "skins/SKIN-CONTRACT.md" },
  core: { files: ["core/tokens.css", "core/base.css", "core/layout.css", "core/tailor.js"], load_order: ["core/tokens.css", "core/base.css", "core/layout.css", "skins/<id>/skin.css", "palettes/<id>.css", "<project>/app.css", "core/tailor.js"] },
  vocabulary: {
    tier1: vocab.components.filter((c) => c.tier === 1).map((c) => c.id),
    tier2: vocab.components.filter((c) => c.tier === 2).map((c) => c.id),
    components: vocab.components.map(({ demo, ...c }) => c),
  },
  skins: skins.map(({ $schema, ...s }) => s),
  palettes: palettes.map((p) => ({ id: p.id, name: p.name, mode: p.mode, modes: modes[p.id], license: p.license, docs: p.docs, file: `palettes/${p.id}.css`, ...(p.primer ? { primer_theme: `react/adapters/primer/themes/${p.mode}_${p.id}.css`, primer_themes: Object.fromEntries(modes[p.id].map((m) => [m, `react/adapters/primer/themes/${m}_${p.id}.css`])) } : {}) })),
  icon_sets: iconSets.map((s) => ({ ...s, samples: iconSamples[s.id] ?? [] })),
  compatibility: compat,
};
writeFileSync(join(ROOT, "manifest.json"), JSON.stringify(manifest, null, 2) + "\n");
log(`manifest.json: ${manifest.vocabulary.tier1.length} tier-1, ${manifest.vocabulary.tier2.length} tier-2, ${skins.length} skins, ${palettes.length} palettes, ${iconSets.length} icon sets`);

// 4b. showcase kit bundle: react/demo/src/kit.tsx → showcase/kit/kit.js (the tailor-react rendering of the demos
// behind the showcase's Kit picker; no CSS of its own, the skin and palette style it). Needs react/node_modules (bun install in react/); otherwise the committed
// bundle is kept. Demo content only — never vendored by `tailor apply`.
const KIT_DIR = join(SHOWCASE, "kit");
if (!argv.includes("--no-kit") && existsSync(join(ROOT, "react", "node_modules", "vite"))) {
  const p = Bun.spawnSync(["bun", "x", "vite", "build", "--config", "vite.kit.config.ts"], { cwd: join(ROOT, "react", "demo"), stdout: "pipe", stderr: "pipe" });
  if (p.exitCode !== 0) { console.error(p.stdout.toString() + p.stderr.toString()); throw new Error("showcase kit: vite build failed"); }
  const size = (f) => `${(statSync(join(KIT_DIR, f)).size / 1024).toFixed(0)} KB`;
  log(`showcase kit: wrote showcase/kit/kit.js (${size("kit.js")})`);
} else {
  log(`showcase kit: skipped — ${argv.includes("--no-kit") ? "--no-kit" : "react/node_modules missing (run bun install in react/)"}; kept the committed showcase/kit/`);
}
const kitBundle = existsSync(join(KIT_DIR, "kit.js"));

// 5. showcase + its sprite: set samples, the mode-toggle icons and every symbol the rendered HTML references
mkdirSync(SHOWCASE, { recursive: true });
const showcaseHtml = renderShowcase({ skins, palettes, modes, iconSets: manifest.icon_sets, kitBundle });
writeFileSync(join(SHOWCASE, "index.html"), showcaseHtml);
log("showcase/index.html written");
if (iconsInstalled()) {
  const sprite = showcaseSprite(Object.values(iconSamples).flat(), showcaseHtml);
  writeFileSync(join(SHOWCASE, "icons.svg"), sprite);
  log(`showcase/icons.svg written (${(sprite.match(/<symbol /g) ?? []).length} symbols)`);
}
