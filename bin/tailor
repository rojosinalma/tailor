#!/usr/bin/env bun
// tailor — the design system CLI. Vendors versioned tailor assets into consuming projects
// (idempotent, no package manager, managed-header files).
//
//   tailor apply <project-dir> [--skin <id[,id...]|all>] [--palettes <id,...>] [--icons <set:name,...>] [--mode dark|light|auto] [--react] [-n]
//   tailor sync  [<project-dir> | --all] [-n]
//   tailor list
//   tailor move <old-dir> <new-dir> [-n]
//   tailor forget <project-dir> [-n]
//   tailor icons search <term> | tailor icons list
//   tailor gen --target primer <palette> | --all
//   tailor gen <system> <palette>
//
// Vendors into <project-dir>/public/tailor/:
//   tokens.css base.css layout.css tailor.js        core (flat)
//   skins/<id>/skin.css                             the chosen skin
//   palettes/<id>.css                               generated from the canonical palettes (palettes/src/)
//   icons.svg                                       sprite of the consumer's icons (--icons), subsetted from the adopted sets
//   tailor-head.html                                <head> snippet: links in contract load order + pre-paint
// Consumers are recorded in <tailor repo>/consumers.json (git-ignored local state, created on the first
// `apply`; shape in consumers.example.json); `sync` re-vendors current versions into them, touching only
// files that carry the managed header.
//
// `tailor gen --target primer <palette>` emits the palette's Primer Primitives theme
// (react/adapters/primer/themes/<mode>_<id>.css, from the pinned @primer/primitives in react/ + the palette's
// `primer` section); `--all` regenerates every one plus themes/index.ts. Without --target, `tailor gen` is an
// optional passthrough to an external theme generator (other design systems' theme artefacts from the same
// palettes): set WEB_UI_DESIGN_ASSETS to its root (it runs <root>/bin/gen-theme <system> <palette>); unset,
// the command explains what is missing.

import { readFileSync, writeFileSync, existsSync, mkdirSync, statSync, readdirSync } from "node:fs";
import { join, resolve, basename, dirname, relative } from "node:path";
import { homedir } from "node:os";
import {
  ROOT, CORE, SKINS, PALETTES_SRC, VERSION, readJson,
  loadPalette, listSourcePalettes, listSkins, paletteCss, paletteModes,
} from "./lib/common.js";
import { listIconSets, iconsInstalled, iconsMissingMessage, loadIconSet, resolveIcon, renderSprite, searchIcons } from "./lib/icons.js";

const CONSUMERS_FILE = join(ROOT, "consumers.json");
const WEB_UI_DESIGN_ASSETS = process.env.WEB_UI_DESIGN_ASSETS || "";
const CORE_FILES = ["tokens.css", "base.css", "layout.css", "tailor.js"];
// Icons Tailor.theme / Tailor.toast / Tailor.confirm render themselves: always part of the consumer sprite.
const THEME_ICONS = ["bi:sun", "bi:moon-stars", "bi:check-circle", "bi:exclamation-triangle", "bi:x-circle", "bi:info-circle", "bi:question-circle", "bi:chevron-down", "bi:clock", "bi:plus-lg", "bi:dash-lg"];
const MARKER = "managed by tailor";
const header = (what, comment = "css") =>
  comment === "html" || comment === "svg"
    ? `<!-- managed by tailor v${VERSION} \u2014 ${what} \u2014 do not edit, run \`tailor sync\` -->\n`
    : `/* managed by tailor v${VERSION} \u2014 ${what} \u2014 do not edit, run \`tailor sync\` */\n`;

const tilde = (p) => p.replace(homedir(), "~");
const die = (msg, code = 1) => { console.error(`tailor: ${msg}`); process.exit(code); };

// ---------- argv ----------
const argv = process.argv.slice(2);
const DRY = ["-n", "--dry-run"].some((f) => { const i = argv.indexOf(f); return i !== -1 && argv.splice(i, 1); });
const cmd = argv.shift();

function takeFlag(name) {
  const i = argv.indexOf(name);
  if (i === -1) return null;
  const v = argv[i + 1];
  if (v === undefined || v.startsWith("--")) die(`${name} needs a value`);
  argv.splice(i, 2);
  return v;
}
function takeBool(name) {
  const i = argv.indexOf(name);
  return i !== -1 ? (argv.splice(i, 1), true) : false;
}
function rejectUnknownFlags() {
  const bad = argv.filter((a) => a.startsWith("-"));
  if (bad.length) die(`unknown flag${bad.length > 1 ? "s" : ""}: ${bad.join(" ")} (see tailor --help)`, 2);
}

// ---------- consumers registry ----------
const loadConsumers = () => (existsSync(CONSUMERS_FILE) ? readJson(CONSUMERS_FILE) : { consumers: [] });
const saveConsumers = (reg) => writeFileSync(CONSUMERS_FILE, JSON.stringify(reg, null, 2) + "\n");
const findConsumer = (reg, dir) => {
  const path = resolve(dir);
  const index = reg.consumers.findIndex((c) => c.path === path);
  return { path, index, entry: index === -1 ? null : reg.consumers[index] };
};
const knownConsumers = (reg) => reg.consumers.map((c) => tilde(c.path)).join(", ") || "none";

// ---------- vendored file set for one consumer ----------
function skinIds() { return listSkins(); }
// "<id,...|all>": `all` expands in place to every known id, duplicates dropped, order kept — so
// `gruvbox,all` = every palette with gruvbox as the default (first = default).
function expandIds(spec, known, flag) {
  const ids = [...new Set(spec.split(",").map((s) => s.trim()).filter(Boolean).flatMap((id) => (id === "all" ? known : [id])))];
  for (const id of ids) if (!known.includes(id)) die(`unknown ${flag} "${id}" \u2014 valid: ${known.join(" ")} (or "all")`);
  if (!ids.length) die(`--${flag === "skin" ? "skin" : "palettes"} needs at least one id \u2014 valid: ${known.join(" ")} (or "all")`);
  return ids;
}
function resolveSkins(spec) { return expandIds(spec, skinIds(), "skin"); }
function resolvePalettes(spec) { return expandIds(spec, listSourcePalettes(), "palette"); }
function resolveIcons(spec) {
  const refs = [...new Set(spec.split(",").map((s) => s.trim()).filter(Boolean))];
  if (!refs.length) die("--icons needs at least one <set>:<name> (e.g. bi:house,lucide:settings)");
  if (!iconsInstalled()) die(iconsMissingMessage());
  for (const r of refs) { try { resolveIcon(r); } catch (e) { die(e.message); } }
  return refs;
}

// `react`: the consumer renders with tailor-react (no tailor.js vendored) — the snippet sets window.TAILOR_CONFIG and
// writes the links before first paint; useTailorTheme / <Ui.Pickers> take over from there.
function headSnippet(project, cfg, react = false) {
  const base = "/tailor/";
  const C = JSON.stringify({ project, base, ...cfg });
  return `${header("head snippet", "html")}<!-- Paste into <head>. Load order (core/conventions.md \u00a71): tokens \u2192 base \u2192 layout \u2192 pre-paint
     (writes the skin + palette links so they cascade over tokens.css) \u2192 your app.css after. -->
<link rel="stylesheet" href="${base}tokens.css">
<link rel="stylesheet" href="${base}base.css">
<link rel="stylesheet" href="${base}layout.css">
<script>
(function(){var C=${C};var P=C.project,q=new URLSearchParams(location.search);
function g(k){var v=q.get(k);try{return v||localStorage.getItem(P+'.'+k)||C.defaults[k]}catch(e){return v||C.defaults[k]}}
var h=document.documentElement,s=g('skin'),p=g('palette'),m=g('mode');
if(C.skins.indexOf(s)<0)s=C.defaults.skin;if(C.palettes.indexOf(p)<0)p=C.defaults.palette;
if(m==='auto')m=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';
var modes=C.modes[p]||['dark'];if(modes.indexOf(m)<0)m=modes[0];
h.dataset.skin=s;h.dataset.palette=p;h.dataset.mode=m;window.TAILOR_CONFIG=C;
document.write('<link id="t-skin" rel="stylesheet" data-base="'+C.base+'skins/" href="'+(s==='none'?'':C.base+'skins/'+s+'/skin.css')+'"'+(s==='none'?' disabled':'')+'>');
document.write('<link id="t-palette" rel="stylesheet" data-base="'+C.base+'palettes/" href="'+C.base+'palettes/'+p+'.css">');})();
</script>
${react ? `<!-- React consumer: no tailor.js \u2014 useTailorTheme() / <Ui.Pickers> from tailor-react read window.TAILOR_CONFIG. -->` : `<script src="${base}tailor.js" defer></script>
<script>document.addEventListener('DOMContentLoaded',function(){if(window.Tailor)Tailor.theme.init(window.TAILOR_CONFIG)});</script>`}
`;
}

// Build { relPath: content } for a consumer spec. Throws on a missing skin/palette/icon.
// `skins` is an array (first = default); legacy consumer rows may still carry `skin` (string).
// `icons` is the consumer's list of <set>:<name> refs → one subsetted sprite, icons.svg (absent when empty).
function fileSet({ project, skins, skin, palettes, icons = [], mode, react }) {
  const list = skins ?? [skin];
  const files = {};
  for (const f of CORE_FILES) {
    if (f === "tailor.js" && react) continue;
    files[f] = header("core") + readFileSync(join(CORE, f), "utf8");
  }
  for (const id of list)
    files[join("skins", id, "skin.css")] = header(`skin ${id}`) + readFileSync(join(SKINS, id, "skin.css"), "utf8");
  const modes = {};
  const labels = { skins: {}, palettes: {} };
  for (const id of list) labels.skins[id] = JSON.parse(readFileSync(join(SKINS, id, "manifest.json"), "utf8")).name || id;
  for (const id of palettes) {
    const p = loadPalette(id);
    modes[id] = paletteModes(p);
    labels.palettes[id] = p.name || id;
    files[join("palettes", `${id}.css`)] = header(`palette ${id}`) + paletteCss(p);
  }
  const sprite = [...new Set([...THEME_ICONS, ...icons])];
  if (!iconsInstalled()) die(iconsMissingMessage());
  files["icons.svg"] = renderSprite(sprite, { header: header(`icons (${sprite.length})`, "svg") });
  const cfg = { skins: [...list, "none"], palettes, modes, labels, defaults: { skin: list[0], palette: palettes[0], mode } };
  files["tailor-head.html"] = headSnippet(project, cfg, react);
  return files;
}

function writeFiles(destRoot, files) {
  const results = [];
  for (const [rel, content] of Object.entries(files)) {
    const dest = join(destRoot, rel);
    const exists = existsSync(dest);
    const current = exists ? readFileSync(dest, "utf8") : null;
    if (exists && current === content) { results.push(["unchanged", dest]); continue; }
    if (exists && !current.includes(MARKER)) { results.push(["refused", dest]); continue; }
    const state = exists ? "changed" : "written";
    if (!DRY) { mkdirSync(dirname(dest), { recursive: true }); writeFileSync(dest, content); }
    results.push([state, dest]);
  }
  return results;
}

function report(results) {
  for (const [state, f] of results) {
    const label = DRY && (state === "changed" || state === "written") ? `would ${state === "written" ? "write" : "change"}` : state;
    console.log(`${label.padEnd(12)} ${tilde(f)}`);
    if (state === "refused")
      console.log(`             ^ no "${MARKER}" header \u2014 hand-edited or foreign file; sync never overwrites it.`);
    if (state === "refused")
      console.log(`               Restore the header (or delete the file) and run \`tailor sync\` again.`);
  }
  return results.some(([s]) => s === "refused");
}

// A consumer's git repo should keep an untracked .git/info/leak-patterns (one extended regex per line) that
// its commits are checked against; a vendored-file commit from sync is one of them. Returns a warning line
// for a public repo (or one whose visibility cannot be told) that has none, else null. Never fatal.
const git = (dir, ...args) => {
  const p = Bun.spawnSync(["git", "-C", dir, ...args], { stdout: "pipe", stderr: "ignore" });
  return p.exitCode === 0 ? p.stdout.toString().trim() : null;
};
function leakPatternsWarning(dir) {
  const commonDir = git(dir, "rev-parse", "--path-format=absolute", "--git-common-dir");
  if (!commonDir || existsSync(join(commonDir, "info", "leak-patterns"))) return null;
  const origin = git(dir, "remote", "get-url", "origin");
  if (!origin) return null; // never published
  const missing = `no ${tilde(join(commonDir, "info", "leak-patterns"))}`;
  const m = origin.match(/github\.com[:/]([^/]+\/[^/]+?)(?:\.git)?$/);
  if (!m) return `${missing} (origin ${origin}, visibility unknown) \u2014 add one before committing the sync`;
  const p = Bun.spawnSync(["gh", "repo", "view", m[1], "--json", "visibility", "-q", ".visibility"], { stdout: "pipe", stderr: "ignore", timeout: 10000 });
  const visibility = p.exitCode === 0 ? p.stdout.toString().trim().toLowerCase() : "";
  if (visibility === "private" || visibility === "internal") return null;
  return `${missing} in ${visibility === "public" ? "public" : "possibly public (gh could not tell)"} repo ${m[1]} \u2014 add one before committing the sync`;
}

// ---------- commands ----------
function cmdApply() {
  const skins = resolveSkins(takeFlag("--skin") ?? "all");
  const palettes = resolvePalettes(takeFlag("--palettes") ?? "all");
  const mode = takeFlag("--mode") ?? "auto";
  if (!["dark", "light", "auto"].includes(mode)) die(`--mode must be dark|light|auto, got "${mode}"`);
  const react = takeBool("--react");
  const iconSpec = takeFlag("--icons");
  rejectUnknownFlags();
  const dir = argv.shift();
  if (!dir) die("usage: tailor apply <project-dir> [--skin <id[,id...]|all>] [--palettes <id[,id...]|all>] [--icons <set:name,...>] [--mode dark|light|auto] [--react] [-n]", 2);
  const projectDir = resolve(dir);
  if (!existsSync(projectDir) || !statSync(projectDir).isDirectory()) die(`not a directory: ${projectDir}`);
  const project = basename(projectDir);
  // --icons replaces the consumer's icon list; without it a re-apply keeps the recorded one
  const recorded = findConsumer(loadConsumers(), projectDir).entry;
  const icons = iconSpec !== null ? resolveIcons(iconSpec) : recorded?.icons ?? [];

  const spec = { project, skins, palettes, icons, mode, react };
  const destRoot = join(projectDir, "public", "tailor");
  const refused = report(writeFiles(destRoot, fileSet(spec)));
  if (react) console.log(`react mode: tailor.js not vendored \u2014 use the adapter workspace at ${tilde(join(ROOT, "react"))}`);
  if (icons.length) console.log(`icons: ${icons.length} symbol${icons.length === 1 ? "" : "s"} in ${tilde(join(destRoot, "icons.svg"))} \u2014 <svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#${icons[0].replace(":", "-")}"/></svg>`);
  console.log(`${DRY ? "would paste" : "paste"} ${tilde(join(destRoot, "tailor-head.html"))} into your layout's <head>.`);

  if (!DRY) {
    const reg = loadConsumers();
    const entry = { path: projectDir, skins, palettes, icons, mode, react, version: VERSION, applied: new Date().toISOString().slice(0, 10) };
    const i = findConsumer(reg, projectDir).index;
    if (i === -1) reg.consumers.push(entry); else reg.consumers[i] = entry;
    saveConsumers(reg);
    console.log(`recorded consumer in ${tilde(CONSUMERS_FILE)} (tailor v${VERSION})`);
  }
  process.exit(refused ? 1 : 0);
}

function cmdSync() {
  const all = takeBool("--all");
  rejectUnknownFlags();
  const reg = loadConsumers();
  let targets = reg.consumers;
  if (!all) {
    const dir = argv.shift();
    if (!dir) die("usage: tailor sync <project-dir> | tailor sync --all", 2);
    const { path: projectDir, entry } = findConsumer(reg, dir);
    targets = entry ? [entry] : [];
    if (!targets.length) die(`${projectDir} is not a recorded consumer \u2014 run \`tailor apply\` first (known: ${knownConsumers(reg)})`);
  }
  if (!targets.length) { console.log("no consumers recorded yet \u2014 run `tailor apply <project-dir>` (see consumers.example.json)"); return; }

  let anyRefused = false;
  for (const c of targets) {
    console.log(`\n${tilde(c.path)} (skins ${(c.skins ?? [c.skin]).join(",")}, palettes ${c.palettes.join(",")}, icons ${(c.icons ?? []).length}, applied v${c.version})`);
    if (!existsSync(c.path)) { console.log("  missing      project directory gone \u2014 `tailor move <old> <new>` if relocated, `tailor forget <dir>` if retired"); continue; }
    const destRoot = join(c.path, "public", "tailor");
    let files;
    try {
      files = fileSet({ project: basename(c.path), skins: c.skins ?? [c.skin], palettes: c.palettes, icons: c.icons ?? [], mode: c.mode ?? "dark", react: c.react });
    } catch (e) { console.log(`  skipped      ${e.message}`); continue; }
    const results = writeFiles(destRoot, files).map(([s, f]) => [s === "written" ? "missing" : s, f]);
    if (report(results)) anyRefused = true;
    const leak = leakPatternsWarning(c.path);
    if (leak) console.log(`  warning      ${leak}`);
    if (!DRY && results.some(([s]) => s !== "unchanged" && s !== "refused")) {
      c.version = VERSION;
      c.applied = new Date().toISOString().slice(0, 10);
    }
  }
  if (!DRY) saveConsumers(reg);
  process.exit(anyRefused ? 1 : 0);
}

function cmdMove() {
  rejectUnknownFlags();
  const [from, to] = argv;
  if (!from || !to) die("usage: tailor move <old-dir> <new-dir> [-n]", 2);
  const reg = loadConsumers();
  const old = findConsumer(reg, from);
  const next = findConsumer(reg, to);
  if (!old.entry) die(`${old.path} is not a recorded consumer (known: ${knownConsumers(reg)})`);
  if (old.path === next.path) die(`old and new path are the same: ${tilde(old.path)}`);
  if (!existsSync(next.path) || !statSync(next.path).isDirectory()) die(`not a directory: ${next.path}`);
  if (next.entry) die(`${tilde(next.path)} is already a recorded consumer \u2014 run \`tailor forget ${tilde(next.path)}\` first (known: ${knownConsumers(reg)})`);
  console.log(`${(DRY ? "would move" : "moved").padEnd(12)} ${tilde(old.path)} -> ${tilde(next.path)}`);
  if (DRY) return;
  old.entry.path = next.path;
  saveConsumers(reg);
  console.log(`recorded in ${tilde(CONSUMERS_FILE)}`);
  console.log(`run \`tailor sync ${tilde(next.path)}\` if its vendored files need refreshing`);
}

function cmdForget() {
  rejectUnknownFlags();
  const dir = argv.shift();
  if (!dir) die("usage: tailor forget <project-dir> [-n]", 2);
  const reg = loadConsumers();
  const { path, index } = findConsumer(reg, dir);
  if (index === -1) die(`${path} is not a recorded consumer (known: ${knownConsumers(reg)})`);
  console.log(`${(DRY ? "would forget" : "forgot").padEnd(12)} ${tilde(path)}`);
  if (DRY) return;
  reg.consumers.splice(index, 1);
  saveConsumers(reg);
  console.log(`recorded in ${tilde(CONSUMERS_FILE)}`);
}

function cmdList() {
  rejectUnknownFlags();
  console.log(`tailor v${VERSION} (${tilde(ROOT)})\n`);
  console.log("skins:");
  const ids = skinIds();
  if (!ids.length) console.log("  (none built yet)");
  for (const id of ids) {
    try {
      const m = readJson(join(SKINS, id, "manifest.json"));
      const ok = existsSync(join(SKINS, id, m.files?.css ?? "skin.css"));
      console.log(`  ${id.padEnd(12)} ${String(m.coverage?.length ?? 0).padStart(3)} components  mode:${(m.palette_constraints?.mode ?? "?").padEnd(6)} ${m.name ?? ""}${ok ? "" : "  [skin.css missing]"}`);
    } catch (e) { console.log(`  ${id.padEnd(12)} (manifest unreadable: ${e.message})`); }
  }
  console.log(`\npalettes (canonical, ${tilde(PALETTES_SRC)}):`);
  const pals = listSourcePalettes();
  if (!pals.length) console.log(`  (none found in ${tilde(PALETTES_SRC)})`);
  for (const id of pals) {
    try { const p = loadPalette(id); console.log(`  ${id.padEnd(14)} ${paletteModes(p).join("+").padEnd(10)} ${p.name}`); }
    catch (e) { console.log(`  ${id.padEnd(14)} (invalid: ${e.message.split("\n")[0]})`); }
  }
  console.log("\nicon sets (icons/sets.json, data via Iconify):");
  const sets = listIconSets();
  if (!sets.length) console.log("  (none adopted)");
  for (const s of sets) {
    try { const set = loadIconSet(s.id); console.log(`  ${s.id.padEnd(14)} ${String(set.count).padStart(5)} icons  ${set.license.padEnd(8)} ${set.name} ${set.version}`); }
    catch (_) { console.log(`  ${s.id.padEnd(14)}     ? icons  ${s.license.padEnd(8)} ${s.name} (not installed \u2014 bun install in icons/)`); }
  }
  console.log("\nconsumers:");
  const reg = loadConsumers();
  if (!reg.consumers.length) console.log("  (none)");
  for (const c of reg.consumers)
    console.log(`  ${tilde(c.path).padEnd(44)} skins:${(c.skins ?? [c.skin]).join(",")} palettes:${c.palettes.join(",")}${c.icons?.length ? ` icons:${c.icons.length}` : ""} v${c.version} (${c.applied})${c.react ? " react" : ""}`);
}

function cmdIcons() {
  const limit = Number(takeFlag("--limit") ?? 50);
  rejectUnknownFlags();
  const sub = argv.shift();
  if (sub === "list") {
    for (const s of listIconSets()) {
      try { const set = loadIconSet(s.id); console.log(`${s.id.padEnd(14)} ${String(set.count).padStart(5)} icons  ${set.license.padEnd(8)} ${set.name} ${set.version}  ${set.upstream}`); }
      catch (_) { console.log(`${s.id.padEnd(14)}     ? icons  ${s.license.padEnd(8)} ${s.name} (not installed)`); }
    }
    return;
  }
  if (sub !== "search" || !argv[0]) die("usage: tailor icons search <term> [--limit N]  |  tailor icons list", 2);
  if (!iconsInstalled()) die(iconsMissingMessage());
  const { total, hits } = searchIcons(argv.join(" "), { limit });
  if (!total) { console.log(`no icon named like "${argv.join(" ")}" in ${listIconSets().map((s) => s.id).join(", ")}`); process.exit(1); }
  for (const h of hits) console.log(h.ref);
  if (total > hits.length) console.log(`\u2026 ${total - hits.length} more (--limit ${total})`);
}

async function cmdGenPrimer() {
  const all = takeBool("--all");
  rejectUnknownFlags();
  const { writePrimerTheme, writePrimerIndex } = await import("./gen-primer-theme");
  const { listPrimerPalettes } = await import("./lib/primer.js");
  const [palette] = argv;
  if (all === !!palette) die("usage: tailor gen --target primer <palette> | tailor gen --target primer --all", 2);
  try {
    const ids = all ? listPrimerPalettes() : [palette];
    if (all && !ids.length) die("no palette has a `primer` section");
    const todo = all ? ids : (listPrimerPalettes().includes(palette) ? ids : die(`palette "${palette}" has no Primer mapping \u2014 palettes with one: ${listPrimerPalettes().join(" ")}`));
    for (const id of todo) { const r = writePrimerTheme(id); console.log(`wrote ${tilde(r.file)}  (${r.stats.tokens} tokens: ${r.stats.overridden} overridden, ${r.stats.exact} exact, ${r.stats.nearest} nearest, ${r.stats.passthrough} pass-through)`); }
    if (all) console.log(`wrote ${tilde(writePrimerIndex(todo))}`);
  } catch (e) { die(e.message); }
}

async function cmdGen() {
  const target = takeFlag("--target");
  if (target === "primer") return cmdGenPrimer();
  if (target) die(`unknown --target "${target}" \u2014 built-in targets: primer (other systems go through the WEB_UI_DESIGN_ASSETS passthrough)`, 2);
  rejectUnknownFlags();
  const [system, palette] = argv;
  if (!system || !palette) die("usage: tailor gen --target primer <palette>|--all  |  tailor gen <system> <palette>  (passthrough to an external theme generator; set WEB_UI_DESIGN_ASSETS to its root)", 2);
  if (!WEB_UI_DESIGN_ASSETS)
    die("`tailor gen` is an optional passthrough to an external theme generator: set WEB_UI_DESIGN_ASSETS to its root (it runs <root>/bin/gen-theme <system> <palette>)");
  const genTheme = join(WEB_UI_DESIGN_ASSETS, "bin", "gen-theme");
  if (!existsSync(genTheme))
    die(`gen-theme not found at ${tilde(genTheme)} \u2014 WEB_UI_DESIGN_ASSETS must point at a theme generator root containing bin/gen-theme`);
  const proc = Bun.spawnSync([genTheme, system, palette], { stdout: "inherit", stderr: "inherit", env: { ...process.env, TAILOR_PALETTES: PALETTES_SRC } });
  process.exit(proc.exitCode ?? 1);
}

const HELP = `tailor v${VERSION} \u2014 vendor the tailor design system into a project (no package manager)

usage:
  tailor apply <project-dir> [--skin <id[,id...]|all>] [--palettes <id[,id...]|all>] [--icons <set:name,...>] [--mode dark|light|auto] [--react] [-n]
      Vendor core + skins + palettes + icon sprite + head snippet into <project-dir>/public/tailor/ and
      record the consumer. Defaults: every skin, every palette, mode auto (adopting = everything tailor
      ships at that moment); the first id listed is the default, so "gruvbox,all" = every palette, gruvbox
      default. --icons lists the icons the project uses
      (icons.svg is subsetted to them + the sun/moon toggle icons; omitted on a re-apply = keep the recorded
      list). --react skips tailor.js (use the react/ adapter).
  tailor sync [<project-dir> | --all] [-n]
      Re-vendor current versions into recorded consumers. Only files carrying the
      "${MARKER}" header are overwritten; anything else is refused.
      Warns (never fails) when a public consumer repo keeps no .git/info/leak-patterns.
  tailor list
      Skins (coverage/mode from manifests), canonical palettes, adopted icon sets, recorded consumers.
  tailor move <old-dir> <new-dir> [-n]
      Repoint a recorded consumer at its new location (relocated project); every other field stays.
  tailor forget <project-dir> [-n]
      Remove a recorded consumer from the registry; files in the project are never touched.
  tailor icons search <term> [--limit N]   |   tailor icons list
      Find an icon by name across the adopted sets (prints <set>:<name> refs for --icons); list the sets.
  tailor gen <system> <palette>
      Optional passthrough to an external theme generator (bootstrap, luz, daisyui, shadcn, webtui,
      primer, …): set WEB_UI_DESIGN_ASSETS to its root; it runs <root>/bin/gen-theme <system> <palette>.

  -n, --dry-run   print what would be written, write nothing

examples:
  tailor apply ~/code/myapp                                   # every skin + palette, bootstrap/first palette default
  tailor apply ~/code/myapp --skin bootstrap,webtui --palettes gruvbox,dracula --mode dark -n
  tailor apply ~/code/myapp --icons bi:house,lucide:settings,simple-icons:github
  tailor icons search gear
  tailor sync --all
  tailor move ~/code/myapp ~/work/myapp
  tailor forget ~/code/oldapp
  tailor gen --target primer dracula
  tailor gen daisyui nord

Vendored files carry: ${header("<what>").trim()}`;

switch (cmd) {
  case "apply": cmdApply(); break;
  case "sync": cmdSync(); break;
  case "list": cmdList(); break;
  case "move": cmdMove(); break;
  case "forget": cmdForget(); break;
  case "icons": cmdIcons(); break;
  case "gen": await cmdGen(); break;
  case undefined: case "-h": case "--help": case "help": console.log(HELP); process.exit(cmd ? 0 : 2); break;
  default: die(`unknown command "${cmd}" (apply|sync|list|move|forget|icons|gen, see tailor --help)`, 2);
}
