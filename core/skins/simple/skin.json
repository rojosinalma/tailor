{
  "id": "simple",
  "name": "Simple",
  "about": "In the style of the classless Simple.css stylesheet.",
  "source": { "name": "Simple.css", "url": "https://simplecss.org", "license": "MIT" },
  "settings": {
    "font-sans": "-apple-system, BlinkMacSystemFont, \"Avenir Next\", Avenir, \"Nimbus Sans L\", Roboto, \"Noto Sans\", \"Segoe UI\", Arial, Helvetica, \"Helvetica Neue\", sans-serif",
    "font-mono": "Consolas, Menlo, Monaco, \"Andale Mono\", \"Ubuntu Mono\", monospace",
    "text-xs": "0.875rem",
    "text-sm": "1rem",
    "text-base": "1.15rem",
    "text-lg": "1.3rem",
    "text-xl": "1.44rem",
    "text-2xl": "2rem",
    "text-3xl": "2.6rem",
    "leading": "1.5",
    "leading-tight": "1.2",
    "weight-normal": "400",
    "weight-medium": "400",
    "weight-bold": "700",
    "heading-weight": "700",
    "label-weight": "400",
    "radius-control": "0.3125rem",
    "radius-box": "0.3125rem",
    "radius-popup": "0.3125rem",
    "radius-check": "0.3125rem",
    "border-w": "1px",
    "focus-w": "2px",
    "focus-offset": "2px",
    "shadow-sm": "none",
    "shadow-md": "none",
    "shadow-lg": "none",
    "card-shadow": "none",
    "btn-shadow": "none",
    "control-h-sm": "2.125rem",
    "control-h-md": "2.5rem",
    "control-h-lg": "3rem",
    "control-px": "0.9rem",
    "btn-weight": "400"
  }
}
