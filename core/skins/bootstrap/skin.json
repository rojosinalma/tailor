{
  "id": "bootstrap",
  "name": "Bootstrap",
  "about": "In the style of the Bootstrap 5.3 toolkit.",
  "source": { "name": "Bootstrap 5.3", "url": "https://getbootstrap.com", "license": "MIT" },
  "settings": {
    "font-sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", \"Noto Sans\", \"Liberation Sans\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
    "font-mono": "SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
    "text-xs": "0.75rem",
    "text-sm": "0.875rem",
    "text-base": "1rem",
    "text-lg": "1.25rem",
    "text-xl": "1.5rem",
    "text-2xl": "1.75rem",
    "text-3xl": "2rem",
    "leading": "1.5",
    "leading-tight": "1.2",
    "weight-normal": "400",
    "weight-medium": "500",
    "weight-bold": "700",
    "heading-weight": "500",
    "label-weight": "400",
    "radius-control": "0.375rem",
    "radius-box": "0.375rem",
    "radius-popup": "0.5rem",
    "radius-pill": "50rem",
    "radius-check": "0.25rem",
    "border-w": "1px",
    "border-w-strong": "2px",
    "focus-w": "0.25rem",
    "focus-offset": "0",
    "focus-color": "color-mix(in srgb, var(--t-focus) 55%, transparent)",
    "shadow-sm": "0 0.125rem 0.25rem rgb(0 0 0 / calc(0.19 * var(--t-shadow-strength)))",
    "shadow-md": "0 0.5rem 1rem rgb(0 0 0 / calc(0.375 * var(--t-shadow-strength)))",
    "shadow-lg": "0 1rem 3rem rgb(0 0 0 / calc(0.44 * var(--t-shadow-strength)))",
    "control-h-sm": "1.9375rem",
    "control-h-md": "2.375rem",
    "control-h-lg": "3rem",
    "control-px": "0.75rem",
    "motion-fast": "150ms",
    "motion-base": "300ms",
    "ease": "ease-in-out",
    "btn-weight": "400",
    "card-header-pb": "var(--t-space-3)",
    "pagination-gap": "0",
    "progress-h": "1rem"
  }
}
