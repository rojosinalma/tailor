  "primer": {
    "$comment": "Modus Vivendi palette for gen-primer-theme. Source: https://github.com/protesilaos/modus-themes modus-themes.el, modus-themes-vivendi-palette (GPL-3.0-or-later — colour values only, no code reused, like Gruvbox). Values: bg-main #000000, bg-dim #1e1e1e, bg-inactive #303030, bg-active #535353, border #646464, bg-popup #0c0c0c, fg-main #ffffff, fg-dim #989898, fg-alt #c6daff, red #ff5f59, green #44bc44, yellow #d0bc00, blue #2fafff, blue-warmer #79a8ff (fg-link), magenta #feacd0, magenta-cooler #b6a0ff, cyan #00d3d0, rust #db7b5f, bg-*-intense #9d1f1f/#2f822f/#7a6100/#1640b0/#7030af/#2266ae, bg-*-subtle #620f2a/#00422a/#4a4000/#242679/#552f5f/#004065. Base: @primer/primitives dark. Canvas black; nothing is darker, so the inset is bg-popup #0c0c0c and shadows stay #000000. Raised bg-dim, borders bg-inactive/bg-active/border, text fg-main / muted fg-dim, disabled border grey. Accent + primary button blue (dark text), link blue-warmer (Modus' own fg-link, not plain blue), success green, danger red, attention yellow, severe rust, done magenta-cooler, sponsors magenta. Emphasis backgrounds are Modus' bg-*-intense values (white text 4.8–8.8:1).",
    "neutral_chroma_max": 0.02,
    "dark_tint_max_L": 0.4,
    "shadow_color": "#000000",
    "chroma_boost": 1,
