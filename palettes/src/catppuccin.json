  "primer": {
    "$comment": "Catppuccin Mocha palette for gen-primer-theme. Base: @primer/primitives dark. Accent/primary mauve, link blue, success green, danger red, attention yellow, severe peach, done mauve, sponsors pink.",
    "neutral_chroma_max": 0.025,
    "dark_tint_max_L": 0.4,
    "shadow_color": "#11111b",
    "chroma_boost": 1.1,
    "hue_ranges": [
      {
        "$comment": "GitHub blues become mauve (accent); the cyan family stays sky/sapphire",
        "min": 236,
        "max": 292,
        "color": "#cba6f7"
      },
      {
        "$comment": "Primer's amber attention hue reads as Mocha yellow",
        "min": 72,
        "max": 100,
        "color": "#f9e2af"
      }
    ],
