  "primer": {
    "$comment": "Vitesse (dark) palette for gen-primer-theme. Source: https://github.com/antfu/vscode-theme-vitesse themes/vitesse-dark.json (MIT) — editor.background #121212, input.background #181818, panel.border #191919, foreground #dbd7ca, secondary #bfbaaa (activityBarBadge), comment #758575, terminal.ansiBrightBlack #777777, primary green #4d9375 (button, textLink, added), green2 #80a665, yellow #e6cc77, orange #d4976c, red #cb7676, blue #6394bf, magenta #d9739f, cyan #5eaab5. Base: @primer/primitives dark. Canvas #121212, raised #181818; Vitesse's borders (#191919) are near-invisible on Primer's bordered components, so the two border steps (#262626, #333333) and the inset (#0a0a0a) are derived. Text foreground / muted secondary, comment green-grey for disabled. Accent + primary button + link + success the Vitesse green (dark text, as its own button), danger red, attention yellow, severe orange, done + sponsors magenta (no purple in Vitesse).",
    "neutral_chroma_max": 0.025,
    "dark_tint_max_L": 0.4,
    "shadow_color": "#0a0a0a",
    "chroma_boost": 1,
    "hue_ranges": [
