    "red": "#cb7676",
    "orange": "#d4976c",
    "yellow": "#e6cc77",
    "green": "#4d9375",
    "cyan": "#5eaab5",
    "purple": "#d9739f",
    "pink": "#d9739f",
    "blue": "#6394bf"
