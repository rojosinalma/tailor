  "primer": {
    "$comment": "Poimandres palette for gen-primer-theme. Source: https://github.com/drcmda/poimandres-theme themes/poimandres-color-theme.json (MIT) — bg #1b1e28, bg2 #303340, bg3 #506477, text #e4f0fb, text2 #a6accd (editor.foreground), text3 #767c9d, white #ffffff, teal #5de4c7, teal2 #5fb3a1, teal3 #42675a, blue #89ddff, blue2 #add7ff (textLink), blue3 #91b4d5, blue4 #7390aa, pink #d0679d, pink2 #f087bd, yellow #fffac2. Base: @primer/primitives dark. Canvas bg, raised bg2, borders bg2/bg3, text #e4f0fb / muted text2 (text3 is 4.1:1 -> disabled), accent + primary button teal (dark text), link blue2 (the theme's own link colour), success teal2, danger pink, attention yellow, severe pink2 and done blue (#89ddff) — Poimandres has no orange and no purple; sponsors pink2. Nothing darker than bg, so inset/shadow #0f1118 is derived.",
    "neutral_chroma_max": 0.025,
    "dark_tint_max_L": 0.4,
    "shadow_color": "#0f1118",
    "chroma_boost": 1,
